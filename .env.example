# 환경별 env 템플릿. 실제 값은 .env.dev / .env.prod 로 작성하세요.
# (.env.dev, .env.prod 는 gitignore 처리됨)
#
# client_secret 은 절대 넣지 마세요 (PKCE 미사용 + 클라이언트 노출 위험).
# redirect_uri 는 DataGSM 콘솔(https://www.datagsm.kr/clients)에 사전 등록 필수.

# Flooding 백엔드 base URL (dev: https://dev.flooding.kr / prod: https://prod.flooding.kr)
API_BASE_URL=

# DataGSM 에서 발급받은 클라이언트 ID
DATAGSM_CLIENT_ID=

# 인증 완료 후 code 를 받을 콜백 URI
DATAGSM_REDIRECT_URI=floodingv2://oauth/callback
