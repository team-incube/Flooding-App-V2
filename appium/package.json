{
  "name": "flooding-appium-tests",
  "private": true,
  "description": "Appium UI tests for Flooding app (appium-flutter-integration-driver + WebdriverIO)",
  "scripts": {
    "postinstall": "patch-package",
    "driver:install": "appium driver install --source npm appium-flutter-integration-driver || appium driver update flutter-integration",
    "driver:list": "appium driver list --installed",
    "build:app": "cd .. && flutter build apk --debug --target integration_test/appium_test.dart",
    "test": "wdio run ./wdio.conf.ts"
  },
  "overrides": {
    "wdio-flutter-by-service": {
      "webdriverio": "$webdriverio",
      "@wdio/globals": "$@wdio/globals"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@wdio/appium-service": "^9.20.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/globals": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "appium": "^3.0.0",
    "appium-flutter-integration-driver": "^2.0.3",
    "patch-package": "^8.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0",
    "wdio-flutter-by-service": "^1.0.0",
    "webdriverio": "^9.20.0"
  }
}
